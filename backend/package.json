{
  "name": "smart-lanka-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types src/auth/password.test.ts src/auth/validation.test.ts src/catalog/validation.test.ts src/cloudinary/signature.test.ts src/cart/validation.test.ts",
    "db:generate": "node scripts/run-drizzle-kit.cjs generate",
    "db:migrate": "node scripts/run-drizzle-kit.cjs migrate",
    "db:studio": "node scripts/run-drizzle-kit.cjs studio",
    "db:seed": "node --experimental-strip-types src/db/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.2"
  }
}
