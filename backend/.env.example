NODE_ENV="development"
PORT="4000"
FRONTEND_URL="http://localhost:3000"

# Neon pooled PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Replace with a random value of at least 32 characters before enabling auth
SESSION_SECRET="replace-with-a-long-random-session-secret"
SESSION_TTL_DAYS="7"
SESSION_COOKIE_NAME="smart_lanka_session"

# Used only by `npm run db:seed -w backend`
SEED_ADMIN_EMAIL="admin@smartlanka.lk"
SEED_ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# Groq: leave empty until the API key is added locally
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional release/demo tooling (never use production passwords here)
DEMO_SEED_PASSWORD=""
SMOKE_BASE_URL="http://localhost:4000"
SMOKE_FRONTEND_ORIGIN="http://localhost:3000"
SMOKE_ADMIN_EMAIL=""
SMOKE_ADMIN_PASSWORD=""

# Disposable transactional E2E: intentionally opt in only against a non-production database
E2E_ALLOW_DATABASE_MUTATION="false"
E2E_BASE_URL="http://localhost:4000"
E2E_FRONTEND_ORIGIN="http://localhost:3000"
E2E_ALLOW_REMOTE="false"
